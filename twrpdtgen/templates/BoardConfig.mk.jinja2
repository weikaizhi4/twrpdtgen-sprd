{% include 'LICENSE.jinja2' %}

DEVICE_PATH := device/{{ device_info.manufacturer }}/{{ device_info.codename }}

# For building with minimal manifest
ALLOW_MISSING_DEPENDENCIES := true

{% if device_info.device_is_ab %}
# A/B
AB_OTA_UPDATER := true
AB_OTA_PARTITIONS +=
{%- for partition in fstab.get_ab_partitions_models() %} \
    {{ partition.name }}
{%- endfor %}

BOARD_USES_RECOVERY_AS_BOOT := true

{% endif %}
# Architecture
TARGET_ARCH := {{ device_info.arch.arch }}
TARGET_ARCH_VARIANT := {{ device_info.arch.arch_variant }}
TARGET_CPU_ABI := {{ device_info.arch.cpu_abi }}
TARGET_CPU_ABI2 := {{ device_info.arch.cpu_abi2 }}
TARGET_CPU_VARIANT := generic
TARGET_CPU_VARIANT_RUNTIME := {{ device_info.cpu_variant }}

{% if device_info.second_arch %}
TARGET_2ND_ARCH := {{ device_info.second_arch.arch }}
TARGET_2ND_ARCH_VARIANT := {{ device_info.second_arch.arch_variant }}
TARGET_2ND_CPU_ABI := {{ device_info.second_arch.cpu_abi }}
TARGET_2ND_CPU_ABI2 := {{ device_info.second_arch.cpu_abi2 }}
TARGET_2ND_CPU_VARIANT := generic
TARGET_2ND_CPU_VARIANT_RUNTIME := {{ device_info.second_cpu_variant }}

{% endif %}
{% if device_info.arch.bitness != 64 %}
TARGET_USES_64_BIT_BINDER := true

{% endif %}
# APEX
{% if device_info.device_uses_updatable_apex %}
DEXPREOPT_GENERATE_APEX_IMAGE := true
{% else %}
OVERRIDE_TARGET_FLATTEN_APEX := true
{% endif %}

# Bootloader
{% if device_info.bootloader_board_name %}
TARGET_BOOTLOADER_BOARD_NAME := {{ device_info.bootloader_board_name }}
{% endif %}
TARGET_NO_BOOTLOADER := true

{% if device_info.screen_density or device_info.use_vulkan %}
# Display
{% if device_info.screen_density %}
TARGET_SCREEN_DENSITY := {{ device_info.screen_density }}
{% endif %}
{% if sprd_profile and sprd_profile.screen_width and sprd_profile.screen_height %}
# Read from the stock Unisoc panel or touchscreen display-coords property.
TARGET_SCREEN_WIDTH := {{ sprd_profile.screen_width }}
TARGET_SCREEN_HEIGHT := {{ sprd_profile.screen_height }}
{% endif %}
{% if device_info.use_vulkan %}
TARGET_USES_VULKAN := true
{% endif %}

{% endif %}
# Kernel
{% if is_sprd_legacy_recovery %}
# Traditional Unisoc recovery image. These values are read directly from the
# stock Android boot header rather than inferred from the unpacking tool.
BOARD_BOOTIMG_HEADER_VERSION := {{ legacy_boot.header_version }}
BOARD_KERNEL_BASE := 0x00000000
BOARD_KERNEL_PAGESIZE := {{ legacy_boot.page_size }}
BOARD_KERNEL_OFFSET := {{ legacy_boot.kernel_addr_hex }}
BOARD_SECOND_OFFSET := 0x00000000
BOARD_RAMDISK_OFFSET := {{ legacy_boot.ramdisk_addr_hex }}
BOARD_KERNEL_TAGS_OFFSET := {{ legacy_boot.tags_addr_hex }}
{% if legacy_boot.dtb_size %}
BOARD_DTB_OFFSET := {{ legacy_boot.dtb_addr_hex }}
{% endif %}
# This is a standalone recovery.img, so its command line is not shared with
# normal Android boot. Force permissive mode before first-stage init starts.
BOARD_KERNEL_CMDLINE := {{ legacy_boot.cmdline }}{% if legacy_boot.cmdline %} {% endif %}androidboot.selinux=permissive
BOARD_MKBOOTIMG_ARGS += --header_version $(BOARD_BOOTIMG_HEADER_VERSION)
BOARD_MKBOOTIMG_ARGS += --kernel_offset $(BOARD_KERNEL_OFFSET)
BOARD_MKBOOTIMG_ARGS += --ramdisk_offset $(BOARD_RAMDISK_OFFSET)
BOARD_MKBOOTIMG_ARGS += --tags_offset $(BOARD_KERNEL_TAGS_OFFSET)
{% if legacy_boot.dtb_size %}
BOARD_MKBOOTIMG_ARGS += --dtb_offset $(BOARD_DTB_OFFSET)
{% endif %}
BOARD_KERNEL_IMAGE_NAME := Image
{% else %}
{% if image_info.header_version != "0" %}
BOARD_BOOTIMG_HEADER_VERSION := {{ image_info.header_version }}
{% endif %}
{% if image_info.base_address %}
BOARD_KERNEL_BASE := {{ image_info.base_address }}
{% endif %}
{% if image_info.cmdline %}
BOARD_KERNEL_CMDLINE := {{ image_info.cmdline }}
{% endif %}
{% if image_info.pagesize %}
BOARD_KERNEL_PAGESIZE := {{ image_info.pagesize }}
{% endif %}
{% if image_info.ramdisk_offset %}
BOARD_RAMDISK_OFFSET := {{ image_info.ramdisk_offset }}
{% endif %}
{% if image_info.tags_offset %}
BOARD_KERNEL_TAGS_OFFSET := {{ image_info.tags_offset }}
{% endif %}
{% if image_info.header_version != "0" %}
BOARD_MKBOOTIMG_ARGS += --header_version $(BOARD_BOOTIMG_HEADER_VERSION)
{% endif %}
{% if image_info.ramdisk_offset %}
BOARD_MKBOOTIMG_ARGS += --ramdisk_offset $(BOARD_RAMDISK_OFFSET)
{% endif %}
{% if image_info.tags_offset %}
BOARD_MKBOOTIMG_ARGS += --tags_offset $(BOARD_KERNEL_TAGS_OFFSET)
{% endif %}
BOARD_KERNEL_IMAGE_NAME := Image
{% endif %}
{% if image_info.dt %}
BOARD_KERNEL_SEPARATED_DT := true
{% endif %}
{% if image_info.dtb %}
BOARD_INCLUDE_DTB_IN_BOOTIMG := true
{% endif %}
{% if image_info.dtbo %}
BOARD_KERNEL_SEPARATED_DTBO := true
{% endif %}
TARGET_KERNEL_CONFIG := {{ device_info.codename }}_defconfig
TARGET_KERNEL_SOURCE := kernel/{{ device_info.manufacturer }}/{{ device_info.codename }}

# Kernel - prebuilt
TARGET_FORCE_PREBUILT_KERNEL := true
ifeq ($(TARGET_FORCE_PREBUILT_KERNEL),true)
TARGET_PREBUILT_KERNEL := $(DEVICE_PATH)/prebuilt/kernel
{% if image_info.dt %}
TARGET_PREBUILT_DT := $(DEVICE_PATH)/prebuilt/dt.img
BOARD_MKBOOTIMG_ARGS += --dt $(TARGET_PREBUILT_DT)
BOARD_KERNEL_SEPARATED_DT := 
{% endif %}
{% if image_info.dtb %}
TARGET_PREBUILT_DTB := $(DEVICE_PATH)/prebuilt/dtb.img
BOARD_MKBOOTIMG_ARGS += --dtb $(TARGET_PREBUILT_DTB)
BOARD_INCLUDE_DTB_IN_BOOTIMG := 
{% endif %}
{% if image_info.dtbo %}
BOARD_PREBUILT_DTBOIMAGE := $(DEVICE_PATH)/prebuilt/dtbo.img
BOARD_KERNEL_SEPARATED_DTBO := 
{% endif %}
endif

# Partitions
{% if device_info.device_uses_system_as_root %}
BOARD_BUILD_SYSTEM_ROOT_IMAGE := true
{% endif %}
{% if image_info.pagesize %}
BOARD_FLASH_BLOCK_SIZE := {{ image_info.pagesize|int * 64 }} # (BOARD_KERNEL_PAGESIZE * 64)
{% endif %}
{% if is_sprd_legacy_recovery %}
# A standalone recovery image does not reveal the boot partition capacity.
BOARD_RECOVERYIMAGE_PARTITION_SIZE := {{ legacy_boot.image_size }}
{% else %}
BOARD_BOOTIMAGE_PARTITION_SIZE := {{ image_info.origsize }}
BOARD_RECOVERYIMAGE_PARTITION_SIZE := {{ image_info.origsize }}
{% endif %}
BOARD_HAS_LARGE_FILESYSTEM := true
{% set system_partition = fstab.get_partition_by_mount_point('/system') %}
{% set product_partition = fstab.get_partition_by_mount_point('/product') %}
{% set system_ext_partition = fstab.get_partition_by_mount_point('/system_ext') %}
{% set vendor_partition = fstab.get_partition_by_mount_point('/vendor') %}
{% set odm_partition = fstab.get_partition_by_mount_point('/odm') %}
{% set vendor_dlkm_partition = fstab.get_partition_by_mount_point('/vendor_dlkm') %}
{% set system_dlkm_partition = fstab.get_partition_by_mount_point('/system_dlkm') %}
BOARD_SYSTEMIMAGE_PARTITION_TYPE := {{ system_partition.fs_type if system_partition else 'ext4' }}
BOARD_SYSTEMIMAGE_FILE_SYSTEM_TYPE := {{ system_partition.fs_type if system_partition else 'ext4' }}
BOARD_USERDATAIMAGE_FILE_SYSTEM_TYPE := ext4
BOARD_VENDORIMAGE_FILE_SYSTEM_TYPE := {{ vendor_partition.fs_type if vendor_partition else 'ext4' }}
BOARD_PRODUCTIMAGE_FILE_SYSTEM_TYPE := {{ product_partition.fs_type if product_partition else 'ext4' }}
BOARD_SYSTEM_EXTIMAGE_FILE_SYSTEM_TYPE := {{ system_ext_partition.fs_type if system_ext_partition else 'ext4' }}
BOARD_ODMIMAGE_FILE_SYSTEM_TYPE := {{ odm_partition.fs_type if odm_partition else 'ext4' }}
BOARD_VENDOR_DLKMIMAGE_FILE_SYSTEM_TYPE := {{ vendor_dlkm_partition.fs_type if vendor_dlkm_partition else 'ext4' }}
BOARD_SYSTEM_DLKMIMAGE_FILE_SYSTEM_TYPE := {{ system_dlkm_partition.fs_type if system_dlkm_partition else 'ext4' }}
TARGET_COPY_OUT_VENDOR := vendor
{% if device_info.device_uses_dynamic_partitions %}
BOARD_SUPER_PARTITION_SIZE := 9126805504 # TODO: Fix hardcoded value
BOARD_SUPER_PARTITION_GROUPS := {{ device_info.manufacturer }}_dynamic_partitions
BOARD_{{ device_info.manufacturer|upper }}_DYNAMIC_PARTITIONS_PARTITION_LIST := {%- for partition in fstab.get_logical_partitions() %} {{ partition.src }}{% endfor %}

BOARD_{{ device_info.manufacturer|upper }}_DYNAMIC_PARTITIONS_SIZE := 9122611200 # TODO: Fix hardcoded value
{% endif %}
{% if image_info.ramdisk_compression == "lzma" %}
LZMA_RAMDISK_TARGETS := recovery
{% endif %}

# Platform
TARGET_BOARD_PLATFORM := {{ device_info.platform }}
{% if sprd_profile %}
BOARD_USES_SPRD_HARDWARE := true
{% endif %}

# Recovery
{% if image_info.dtbo and not device_info.device_is_ab %}
BOARD_INCLUDE_RECOVERY_DTBO := true
{% endif %}
{% if is_sprd_legacy_recovery %}
TARGET_RECOVERY_FSTAB := $(DEVICE_PATH)/recovery/root/system/etc/recovery.fstab
{% endif %}
{% if device_info.device_pixel_format %}
TARGET_RECOVERY_PIXEL_FORMAT := {{ device_info.device_pixel_format }}
{% endif %}
{% if sprd_profile and not is_sprd_legacy_recovery %}
# The recovery root is read-only; do not stage an additional fstab under /etc.
TW_SKIP_ADDITIONAL_FSTAB := true
TW_EMBEDDED_VENDOR_LIBS := true
{% endif %}
TARGET_USERIMAGES_USE_EXT4 := true
TARGET_USERIMAGES_USE_F2FS := true

{% if device_info.vendor_build_security_patch %}
# Security patch level
VENDOR_SECURITY_PATCH := 2021-08-01

{% endif %}
{% if image_info.sigtype == "AVBv2" %}
# Verified Boot
BOARD_AVB_ENABLE := true
BOARD_AVB_MAKE_VBMETA_IMAGE_ARGS += --flags 3
{% if not device_info.device_is_ab %}
BOARD_AVB_RECOVERY_KEY_PATH := external/avb/test/data/testkey_rsa4096.pem
BOARD_AVB_RECOVERY_ALGORITHM := SHA256_RSA4096
BOARD_AVB_RECOVERY_ROLLBACK_INDEX := 1
BOARD_AVB_RECOVERY_ROLLBACK_INDEX_LOCATION := 1
{% endif %}

{% endif %}
# Hack: prevent anti rollback
{% if sprd_profile %}
PLATFORM_VERSION := {{ sprd_profile.android_release }}
{% if sprd_profile.security_patch %}
PLATFORM_SECURITY_PATCH := {{ sprd_profile.security_patch }}
{% endif %}
{% if sprd_profile.vendor_security_patch %}
VENDOR_SECURITY_PATCH := {{ sprd_profile.vendor_security_patch }}
{% endif %}
{% else %}
PLATFORM_SECURITY_PATCH := 2099-12-31
VENDOR_SECURITY_PATCH := 2099-12-31
PLATFORM_VERSION := 16.1.0
{% endif %}

# TWRP Configuration
TW_THEME := portrait_hdpi
TW_EXTRA_LANGUAGES := true
TW_SCREEN_BLANK_ON_BOOT := true
TW_INPUT_BLACKLIST := "hbtp_vm"
TW_USE_TOOLBOX := true
{% if sprd_profile %}
{% if is_sprd_legacy_recovery %}
# Android 11 Unisoc traditional recovery has no usable keymaster/FBE service.
TW_INCLUDE_CRYPTO := false
TW_INCLUDE_CRYPTO_FBE := false
TWRP_INCLUDE_LOGCAT := true
TARGET_USES_LOGD := true
TW_NO_HAPTICS := true
TW_INCLUDE_REPACKTOOLS := true
TW_INCLUDE_RESETPROP := true
TW_INCLUDE_LIBRESETPROP := true
TW_NO_FLASH_CURRENT_TWRP := true
TW_NO_FASTBOOT_BOOT := true
TARGET_EXCLUDE_BOOTCTRL := true
TARGET_NO_UPDATE_ENGINE := true
TARGET_NO_RECOVERY_UPDATE_ENGINE := true
TARGET_BOOTCTRL_DISABLE := true
TARGET_BOARD_PLATFORM_NO_BOOTCTRL := true
USE_GENERIC_BOOTCTRL_HEADERS := true
BOARD_BOOTCTRL_HEADER_VERSION := 0
{% else %}
TW_INCLUDE_CRYPTO := true
TW_INCLUDE_CRYPTO_FBE := true
{% endif %}
{% if sprd_profile.uses_sc27xx_haptics %}
TW_SUPPORT_SC27XX_INPUT_HAPTICS := true
{% endif %}
{% if sprd_profile.needs_legacy_drm %}
TW_DRM_LEGACY_MODESET := true
{% endif %}
{% if sprd_profile.copy_stock_selinux and vendor_boot %}
# Run tools/patch_stock_sepolicy.sh with a libsepol-backed SEPOLICY_PATCHER before building.
{% endif %}
{% endif %}
{% if device_info.device_is_ab %}
TW_INCLUDE_REPACKTOOLS := true
{% endif %}
